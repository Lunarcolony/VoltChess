# Copy to backend/.env on the Raspberry Pi (or project root when running locally)

DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=false
# Comma-separated: Pi LAN IP, localhost, * for Cloudflare tunnel hostnames
DJANGO_ALLOWED_HOSTS=*

# SQLite is simplest for Pi testing; set false and configure Postgres for production
USE_SQLITE=true

# PostgreSQL (when USE_SQLITE=false)
POSTGRES_DB=voltchess
POSTGRES_USER=voltchess
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Frontend origins allowed to call this API (comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://voltchess.vercel.app

# Gunicorn bind address (0.0.0.0 = reachable on LAN and via port forward / tunnel)
GUNICORN_BIND=0.0.0.0:8000
GUNICORN_WORKERS=2

# Server-side Stockfish for background analysis when the browser tab is closed
# setup-pi.sh sets this automatically on the Pi (/usr/games/stockfish)
STOCKFISH_PATH=/usr/games/stockfish
