# =============================================================================
# Public site origin (canonical URLs, sitemap, OG, prerender).
# Set the same value in Vercel → Environment Variables (Production + Preview).
# Also set VITE_API_URL to your live API so telemetry (and Academy) can sync.
VITE_SITE_URL=https://voltchess.vercel.app

# =============================================================================
# REQUIRED on Vercel — HTTPS API URL (Cloudflare tunnel or custom domain).
# Run on Pi: cat ~/VoltChess/backend/PUBLIC_API_URL.txt
# Example:     https://your-subdomain.trycloudflare.com
# Do NOT commit your live URL or LAN IP to GitHub — set this in Vercel env vars only.
VITE_API_URL=https://your-subdomain.trycloudflare.com

# Local dev: Vite proxies /api to this backend (server-side only — not in browser bundle).
# API_PROXY_TARGET=http://127.0.0.1:8000

# Auth is ON by default for Academy (coach/student routes).
# Public game analysis (/, /analysis, landing pages) is always open regardless.
# Set VITE_ENABLE_AUTHENTICATION=false only for local dev without the Pi API.
# VITE_ENABLE_AUTHENTICATION=false

# Set VITE_SHOW_SIGN_IN_BUTTON=true when Academy sign-in is ready for public users.
# /login stays available by direct URL either way.
# VITE_SHOW_SIGN_IN_BUTTON=true

# Firebase Configuration
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id

# Sentry Configuration (optional)
VITE_SENTRY_DSN=your_sentry_dsn_url
